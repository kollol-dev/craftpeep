{
  "spec": "0.2",
  "id": "com.craftpeep.repository-list",
  "name": "Rising Repositories",
  "symbol": "chevron.left.forwardslash.chevron.right",
  "description": "The fastest-growing repositories on GitHub that CraftPeep has seen.",
  "version": "2.0.0",
  "sizes": [
    "small",
    "medium",
    "large"
  ],
  "settings": [
    {
      "key": "language",
      "type": "string",
      "label": "Language",
      "default": "",
      "help": "For example Swift or Rust. Leave empty for any language."
    }
  ],
  "data": {
    "repos": {
      "type": "query",
      "from": "repositories",
      "where": {
        "language": "{{ settings.language }}"
      },
      "sort": "rank",
      "limit": 10
    }
  },
  "view": {
    "small": {
      "type": "vstack",
      "padding": 12,
      "spacing": 0,
      "align": "leading",
      "children": [
        {
          "type": "list",
          "each": "{{ data.repos }}",
          "as": "r",
          "limit": 3,
          "spacing": 11,
          "item": {
            "type": "hstack",
            "spacing": 10,
            "children": [
              {
                "type": "text",
                "text": "{{ r.monogram }}",
                "width": 18,
                "height": 18,
                "background": "{{ r.sourceColor }}",
                "radius": 5,
                "color": "#FFFFFF",
                "size": "caption",
                "weight": "bold",
                "design": "rounded",
                "align": "center",
                "lines": 1
              },
              {
                "type": "vstack",
                "spacing": 2,
                "align": "leading",
                "children": [
                  {
                    "type": "text",
                    "text": "{{ r.fullName }}",
                    "lines": 1,
                    "weight": "medium",
                    "action": {
                      "type": "openURL",
                      "value": "{{ r.url }}"
                    }
                  },
                  {
                    "type": "text",
                    "text": "{{ r.language ? r.language + ' · ' : '' }}{{ r.growth }}",
                    "size": "caption",
                    "color": "secondary",
                    "lines": 1
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "default": {
      "type": "vstack",
      "padding": 12,
      "spacing": 0,
      "align": "leading",
      "children": [
        {
          "type": "list",
          "each": "{{ data.repos }}",
          "as": "r",
          "limit": 5,
          "spacing": 11,
          "item": {
            "type": "vstack",
            "spacing": 0,
            "align": "leading",
            "children": [
              {
                "type": "vstack",
                "spacing": 6,
                "align": "leading",
                "when": "{{ index == 0 }}",
                "children": [
                  {
                    "type": "hstack",
                    "spacing": 8,
                    "children": [
                      {
                        "type": "text",
                        "text": "{{ r.monogram }}",
                        "width": 28,
                        "height": 28,
                        "background": "{{ r.sourceColor }}",
                        "radius": 8,
                        "color": "#FFFFFF",
                        "size": "body",
                        "weight": "bold",
                        "design": "rounded",
                        "align": "center",
                        "lines": 1
                      },
                      {
                        "type": "vstack",
                        "spacing": 1,
                        "align": "leading",
                        "children": [
                          {
                            "type": "text",
                            "text": "{{ r.name }}",
                            "size": "body",
                            "weight": "bold",
                            "lines": 1,
                            "action": {
                              "type": "openURL",
                              "value": "{{ r.url }}"
                            }
                          },
                          {
                            "type": "text",
                            "text": "{{ r.owner }}",
                            "size": "caption",
                            "color": "secondary",
                            "lines": 1
                          }
                        ]
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "badge",
                        "text": "{{ r.isMeasured ? 'Measured' : 'Estimate' }}",
                        "color": "accent"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "when": "{{ r.description }}",
                    "text": "{{ r.description }}",
                    "size": "caption",
                    "lines": 2
                  },
                  {
                    "type": "text",
                    "text": "{{ r.language ? r.language + ' · ' : '' }}{{ r.growth }}",
                    "size": "caption",
                    "weight": "medium",
                    "color": "accent",
                    "lines": 1
                  },
                  {
                    "type": "divider"
                  }
                ]
              },
              {
                "type": "hstack",
                "spacing": 10,
                "children": [
                  {
                    "type": "text",
                    "text": "{{ r.monogram }}",
                    "width": 22,
                    "height": 22,
                    "background": "{{ r.sourceColor }}",
                    "radius": 6,
                    "color": "#FFFFFF",
                    "size": "caption",
                    "weight": "bold",
                    "design": "rounded",
                    "align": "center",
                    "lines": 1
                  },
                  {
                    "type": "vstack",
                    "spacing": 2,
                    "align": "leading",
                    "children": [
                      {
                        "type": "text",
                        "text": "{{ r.fullName }}",
                        "lines": 1,
                        "weight": "medium",
                        "action": {
                          "type": "openURL",
                          "value": "{{ r.url }}"
                        }
                      },
                      {
                        "type": "text",
                        "text": "{{ r.language ? r.language + ' · ' : '' }}{{ r.growth }}",
                        "size": "caption",
                        "color": "secondary",
                        "lines": 1
                      }
                    ]
                  }
                ],
                "when": "{{ index > 0 }}"
              }
            ]
          }
        }
      ]
    },
    "large": {
      "type": "vstack",
      "padding": 14,
      "spacing": 0,
      "align": "leading",
      "children": [
        {
          "type": "list",
          "each": "{{ data.repos }}",
          "as": "r",
          "limit": 8,
          "spacing": 11,
          "item": {
            "type": "vstack",
            "spacing": 0,
            "align": "leading",
            "children": [
              {
                "type": "vstack",
                "spacing": 6,
                "align": "leading",
                "when": "{{ index == 0 }}",
                "children": [
                  {
                    "type": "hstack",
                    "spacing": 8,
                    "children": [
                      {
                        "type": "text",
                        "text": "{{ r.monogram }}",
                        "width": 28,
                        "height": 28,
                        "background": "{{ r.sourceColor }}",
                        "radius": 8,
                        "color": "#FFFFFF",
                        "size": "body",
                        "weight": "bold",
                        "design": "rounded",
                        "align": "center",
                        "lines": 1
                      },
                      {
                        "type": "vstack",
                        "spacing": 1,
                        "align": "leading",
                        "children": [
                          {
                            "type": "text",
                            "text": "{{ r.name }}",
                            "size": "body",
                            "weight": "bold",
                            "lines": 1,
                            "action": {
                              "type": "openURL",
                              "value": "{{ r.url }}"
                            }
                          },
                          {
                            "type": "text",
                            "text": "{{ r.owner }}",
                            "size": "caption",
                            "color": "secondary",
                            "lines": 1
                          }
                        ]
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "badge",
                        "text": "{{ r.isMeasured ? 'Measured' : 'Estimate' }}",
                        "color": "accent"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "when": "{{ r.description }}",
                    "text": "{{ r.description }}",
                    "size": "caption",
                    "lines": 3
                  },
                  {
                    "type": "text",
                    "text": "{{ r.language ? r.language + ' · ' : '' }}{{ r.growth }}",
                    "size": "caption",
                    "weight": "medium",
                    "color": "accent",
                    "lines": 1
                  },
                  {
                    "type": "divider"
                  }
                ]
              },
              {
                "type": "hstack",
                "spacing": 10,
                "children": [
                  {
                    "type": "text",
                    "text": "{{ r.monogram }}",
                    "width": 22,
                    "height": 22,
                    "background": "{{ r.sourceColor }}",
                    "radius": 6,
                    "color": "#FFFFFF",
                    "size": "caption",
                    "weight": "bold",
                    "design": "rounded",
                    "align": "center",
                    "lines": 1
                  },
                  {
                    "type": "vstack",
                    "spacing": 2,
                    "align": "leading",
                    "children": [
                      {
                        "type": "text",
                        "text": "{{ r.fullName }}",
                        "lines": 1,
                        "weight": "medium",
                        "action": {
                          "type": "openURL",
                          "value": "{{ r.url }}"
                        }
                      },
                      {
                        "type": "text",
                        "when": "{{ r.description }}",
                        "text": "{{ r.description }}",
                        "size": "caption",
                        "color": "secondary",
                        "lines": 1
                      },
                      {
                        "type": "text",
                        "text": "{{ r.language ? r.language + ' · ' : '' }}{{ r.growth }}",
                        "size": "caption",
                        "color": "secondary",
                        "lines": 1
                      }
                    ]
                  }
                ],
                "when": "{{ index > 0 }}"
              }
            ]
          }
        }
      ]
    }
  }
}
