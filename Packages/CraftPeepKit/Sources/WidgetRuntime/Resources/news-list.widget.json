{
  "spec": "0.2",
  "id": "com.craftpeep.news-list",
  "name": "News",
  "symbol": "newspaper.fill",
  "description": "Your top stories, the latest, saved stories or any folder. Switch from the widget's header.",
  "version": "2.0.0",
  "sizes": [
    "small",
    "medium",
    "large"
  ],
  "settings": [
    {
      "key": "view",
      "type": "string",
      "label": "Shows",
      "default": "overview",
      "help": "Overview, ai, latest, saved, or folder:Name. The menu in the widget's header sets this."
    },
    {
      "key": "showSources",
      "type": "boolean",
      "label": "Show source and time",
      "default": true
    }
  ],
  "data": {
    "stories": {
      "type": "query",
      "from": "stories",
      "where": {
        "view": "{{ settings.view }}"
      },
      "limit": 10
    }
  },
  "view": {
    "small": {
      "type": "vstack",
      "padding": 12,
      "spacing": 0,
      "align": "leading",
      "children": [
        {
          "type": "list",
          "each": "{{ data.stories }}",
          "as": "s",
          "limit": 3,
          "spacing": 11,
          "item": {
            "type": "hstack",
            "spacing": 10,
            "children": [
              {
                "type": "text",
                "text": "{{ s.monogram }}",
                "width": 18,
                "height": 18,
                "background": "{{ s.sourceColor }}",
                "radius": 5,
                "color": "#FFFFFF",
                "size": "caption",
                "weight": "bold",
                "design": "rounded",
                "align": "center",
                "lines": 1
              },
              {
                "type": "vstack",
                "spacing": 2,
                "align": "leading",
                "children": [
                  {
                    "type": "text",
                    "text": "{{ s.headline }}",
                    "lines": 2,
                    "weight": "medium",
                    "color": "{{ s.isRead ? 'secondary' : 'primary' }}",
                    "action": {
                      "type": "openURL",
                      "value": "{{ s.url }}"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "default": {
      "type": "vstack",
      "padding": 12,
      "spacing": 0,
      "align": "leading",
      "children": [
        {
          "type": "list",
          "each": "{{ data.stories }}",
          "as": "s",
          "limit": 5,
          "spacing": 11,
          "item": {
            "type": "vstack",
            "spacing": 0,
            "align": "leading",
            "children": [
              {
                "type": "vstack",
                "spacing": 6,
                "align": "leading",
                "when": "{{ index == 0 }}",
                "children": [
                  {
                    "type": "hstack",
                    "spacing": 6,
                    "children": [
                      {
                        "type": "text",
                        "text": "{{ s.monogram }}",
                        "width": 18,
                        "height": 18,
                        "background": "{{ s.sourceColor }}",
                        "radius": 5,
                        "color": "#FFFFFF",
                        "size": "caption",
                        "weight": "bold",
                        "design": "rounded",
                        "align": "center",
                        "lines": 1
                      },
                      {
                        "type": "text",
                        "text": "{{ s.source }}",
                        "size": "caption",
                        "weight": "medium",
                        "color": "secondary",
                        "lines": 1
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "badge",
                        "when": "{{ s.kind }}",
                        "text": "{{ s.kind }}",
                        "color": "accent"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "{{ s.headline }}",
                    "size": "body",
                    "weight": "bold",
                    "lines": 3,
                    "color": "{{ s.isRead ? 'secondary' : 'primary' }}",
                    "action": {
                      "type": "openURL",
                      "value": "{{ s.url }}"
                    }
                  },
                  {
                    "type": "text",
                    "when": "{{ s.excerpt }}",
                    "text": "{{ s.excerpt }}",
                    "size": "caption",
                    "color": "secondary",
                    "lines": 2
                  },
                  {
                    "type": "text",
                    "text": "{{ ago(s.publishedAt) }}{{ s.sourceCount > 1 ? ' · ' + s.sourceCount + ' sources' : '' }}",
                    "size": "caption",
                    "color": "secondary",
                    "lines": 1
                  },
                  {
                    "type": "divider"
                  }
                ]
              },
              {
                "type": "hstack",
                "spacing": 10,
                "children": [
                  {
                    "type": "text",
                    "text": "{{ s.monogram }}",
                    "width": 22,
                    "height": 22,
                    "background": "{{ s.sourceColor }}",
                    "radius": 6,
                    "color": "#FFFFFF",
                    "size": "caption",
                    "weight": "bold",
                    "design": "rounded",
                    "align": "center",
                    "lines": 1
                  },
                  {
                    "type": "vstack",
                    "spacing": 2,
                    "align": "leading",
                    "children": [
                      {
                        "type": "text",
                        "text": "{{ s.headline }}",
                        "lines": 2,
                        "weight": "medium",
                        "color": "{{ s.isRead ? 'secondary' : 'primary' }}",
                        "action": {
                          "type": "openURL",
                          "value": "{{ s.url }}"
                        }
                      },
                      {
                        "type": "text",
                        "when": "{{ settings.showSources }}",
                        "text": "{{ s.source }}{{ s.sourceCount > 1 ? ' +' + (s.sourceCount - 1) : '' }} · {{ ago(s.publishedAt) }}",
                        "size": "caption",
                        "color": "secondary",
                        "lines": 1
                      }
                    ]
                  }
                ],
                "when": "{{ index > 0 }}"
              }
            ]
          }
        }
      ]
    },
    "large": {
      "type": "vstack",
      "padding": 14,
      "spacing": 0,
      "align": "leading",
      "children": [
        {
          "type": "list",
          "each": "{{ data.stories }}",
          "as": "s",
          "limit": 9,
          "spacing": 11,
          "item": {
            "type": "vstack",
            "spacing": 0,
            "align": "leading",
            "children": [
              {
                "type": "vstack",
                "spacing": 6,
                "align": "leading",
                "when": "{{ index == 0 }}",
                "children": [
                  {
                    "type": "hstack",
                    "spacing": 6,
                    "children": [
                      {
                        "type": "text",
                        "text": "{{ s.monogram }}",
                        "width": 18,
                        "height": 18,
                        "background": "{{ s.sourceColor }}",
                        "radius": 5,
                        "color": "#FFFFFF",
                        "size": "caption",
                        "weight": "bold",
                        "design": "rounded",
                        "align": "center",
                        "lines": 1
                      },
                      {
                        "type": "text",
                        "text": "{{ s.source }}",
                        "size": "caption",
                        "weight": "medium",
                        "color": "secondary",
                        "lines": 1
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "badge",
                        "when": "{{ s.kind }}",
                        "text": "{{ s.kind }}",
                        "color": "accent"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "{{ s.headline }}",
                    "size": "title",
                    "weight": "bold",
                    "lines": 3,
                    "color": "{{ s.isRead ? 'secondary' : 'primary' }}",
                    "action": {
                      "type": "openURL",
                      "value": "{{ s.url }}"
                    }
                  },
                  {
                    "type": "text",
                    "when": "{{ s.excerpt }}",
                    "text": "{{ s.excerpt }}",
                    "size": "caption",
                    "color": "secondary",
                    "lines": 3
                  },
                  {
                    "type": "text",
                    "text": "{{ ago(s.publishedAt) }}{{ s.sourceCount > 1 ? ' · ' + s.sourceCount + ' sources' : '' }}",
                    "size": "caption",
                    "color": "secondary",
                    "lines": 1
                  },
                  {
                    "type": "divider"
                  }
                ]
              },
              {
                "type": "hstack",
                "spacing": 10,
                "children": [
                  {
                    "type": "text",
                    "text": "{{ s.monogram }}",
                    "width": 22,
                    "height": 22,
                    "background": "{{ s.sourceColor }}",
                    "radius": 6,
                    "color": "#FFFFFF",
                    "size": "caption",
                    "weight": "bold",
                    "design": "rounded",
                    "align": "center",
                    "lines": 1
                  },
                  {
                    "type": "vstack",
                    "spacing": 2,
                    "align": "leading",
                    "children": [
                      {
                        "type": "text",
                        "text": "{{ s.headline }}",
                        "lines": 2,
                        "weight": "medium",
                        "color": "{{ s.isRead ? 'secondary' : 'primary' }}",
                        "action": {
                          "type": "openURL",
                          "value": "{{ s.url }}"
                        }
                      },
                      {
                        "type": "text",
                        "when": "{{ settings.showSources }}",
                        "text": "{{ s.source }}{{ s.sourceCount > 1 ? ' +' + (s.sourceCount - 1) : '' }} · {{ ago(s.publishedAt) }}",
                        "size": "caption",
                        "color": "secondary",
                        "lines": 1
                      }
                    ]
                  }
                ],
                "when": "{{ index > 0 }}"
              }
            ]
          }
        }
      ]
    }
  }
}
